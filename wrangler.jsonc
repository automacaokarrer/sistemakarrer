{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "karrer-atendimento",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "crmkarrer.com.br",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "karrer-atendimento-db",
      "database_id": "631cbff2-c110-4983-bed1-bffb2cdac1f7",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "karrer-atendimento-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOMS", "class_name": "ChatRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["OPENAI_API_KEY", "OPENAI_LUNA_AGENT_ID"]
  },
  "vars": {
    "APP_NAME": "Karrer Atendimento",
    "ENVIRONMENT": "production",
    "APP_BASE_URL": "https://crmkarrer.com.br",
    "OPENAI_TRANSCRIPTION_MODEL": "gpt-4o-mini-transcribe"
  }
}
