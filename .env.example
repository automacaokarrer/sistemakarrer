# Copie este arquivo para .env e preencha somente no ambiente local.
# Nunca coloque valores reais neste arquivo de exemplo.

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=example.com

# Aplicacao / Z-API
BOOTSTRAP_ADMIN_TOKEN=
ZAPI_INSTANCE_ID=
ZAPI_INSTANCE_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_WEBHOOK_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=Karrer Atendimento <acesso@example.com>
APP_BASE_URL=https://example.com

# Google Drive (conta de serviço e pasta compartilhada com ela)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
