{
  "name": "karrer-atendimento",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-dev-vars.mjs",
    "dev": "vite dev",
    "prebuild": "node scripts/sync-dev-vars.mjs --empty",
    "build": "tsc -b && vite build",
    "prepreview": "node scripts/sync-dev-vars.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b --pretty false",
    "precf-typegen": "node scripts/sync-dev-vars.mjs --empty",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply karrer-atendimento-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply karrer-atendimento-db --remote",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "openai": "^7.15.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
